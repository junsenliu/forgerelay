PORT=8080
APP_BASE_URL=http://localhost:8080

# Gemini / Google Cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DataHub MCP. Use either a remote Streamable HTTP endpoint or a local stdio server.
DATAHUB_MCP_URL=
DATAHUB_MCP_TOKEN=
DATAHUB_MCP_COMMAND=
DATAHUB_MCP_ARGS=
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
DATAHUB_ENABLE_MUTATIONS=false

# CockroachDB persistent memory
DATABASE_URL=
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_TOKEN=
COCKROACH_CLUSTER_ID=
COCKROACH_DATABASE=defaultdb

# CALL-E
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
ENABLE_LIVE_CALLS=false
